# Copy to .env (never commit .env). Every value marked REQUIRED must be set.
# Comments must be on their own line: docker compose reads "VAR=  # text" as the value "# text".

# --- Stack identity (ADR-0002): demo = nearhk/32080/10.88.0.0/24 · real = nearhklive/32081/10.88.1.0/24 ---
STACK=nearhk
STACK_SUBNET=10.88.0.0/24

# --- Public exposure (host nginx proxies the domain → this port) ---
PUBLIC_BIND=127.0.0.1
PUBLIC_HTTP_PORT=32080

# --- Database ---
POSTGRES_DB=tesorero
POSTGRES_USER=tesorero
# REQUIRED: long random string
POSTGRES_PASSWORD=

# --- Auth ---
# REQUIRED: >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# --- AI (DeepSeek, OpenAI-compatible) ---
# REQUIRED
DEEPSEEK_API_KEY=
AI_EXTRACTION_MODEL=deepseek-flash
AI_PLANNER_MODEL=deepseek-v4-pro

# --- NEAR ---
# optional: 1Click partner JWT (without it 1Click adds a small fee)
INTENTS_JWT=
NEAR_RPC_URL=https://free.rpc.fastnear.com
# optional: NEAR account whose USDC balance the dashboard shows
TREASURY_ACCOUNT_ID=

# --- Autonomous Live payments (ADR-0005, docs/guides/MAINNET.md) ---
# Never paste a key here by hand from another machine: generate it on the server with
#   docker compose run --rm --no-deps api generate-agent-key >> .env
NEAR_AGENT_ACCOUNT_ID=
NEAR_AGENT_PRIVATE_KEY=

# --- Multitenancy (ADR-0006) ---
TENANCY_BASE_DOMAIN=tesorero.gesco.ec
TENANCY_DEFAULT_SLUG=demo
# REQUIRED on the multi-tenant stack: base64 of 32 random bytes (encrypts tenant agent keys). Back it up.
TENANCY_KEY_ENCRYPTION_KEY=

# --- E-mail (SMTP) for signup verification; empty host = e-mails are logged ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_FROM_NAME=Tesorero

# --- Instance type ---
# SEED_DEMO=true  → public demo: demo users and data, reset button, Live mode forbidden.
# SEED_DEMO=false → real instance: no demo data; the first visit runs the setup wizard.
SEED_DEMO=true
# One-time first-run setup code (real instances). Generated on the server by scripts/deploy.sh.
SETUP_TOKEN=
SEED_DEMO_PASSWORD=Demo!2026
SEED_ORGANIZATION_NAME=Cafetería La Ceiba

# --- Build metadata (set by scripts/deploy.sh) ---
APP_VERSION=dev
APP_COMMIT=local
APP_BUILT_AT=local
